post ||--o{ post_uploads : "has media"
media ||--o{ post_uploads : "attached to"
post ||--o{ post_hashtag : "tagged"
hashtag ||--o{ post_hashtag : "used in"
post ||--o{ post_favorites : "favorited"
post ||--o{ like : "liked"

