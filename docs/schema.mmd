erDiagram

%% ---------------------------------------------------------
%% USERS & AUTH (Gray/Blue/Pink)
%% ---------------------------------------------------------
user {
    bigint id PK
    varchar username UK
    varchar domain
    varchar email UK
    varchar email_confirmation_token
    timestamp email_confirmed_at
    varchar password_hash
    varchar display_name
    text biography
    char language
    char locale
    varchar timezone
    bigint profile_picture FK
    bigint banner_picture FK
    bool is_banned
    bool is_disabled
    varchar stripe_account_id
    timestamp last_login_at
    timestamp registered_at
    timestamp updated_at
}

role {
    bigint id PK
    varchar name
    text description
    timestamp created_at
}

user_roles {
    bigint user_id PK,FK
    bigint role_id PK,FK
    timestamp assigned_at
    bigint assigned_by
}

permission {
    bigint id PK
    varchar name
    bigint scope_id FK
    text description
}

role_permissions {
    bigint role_id PK,FK
    bigint permission_id PK,FK
}

scope {
    bigint id PK
    varchar name
}

follow {
    bigint source_user_id PK,FK
    bigint target_user_id PK,FK
    timestamp followed_at
}

%% ---------------------------------------------------------
%% MONETARY / TRANSACTIONS (Green)
%% ---------------------------------------------------------
payment {
    bigint id PK
    bigint payer_id FK
    bigint payee_id FK
    decimal amount
    enum status
    varchar external_ref
    timestamp payed_at
}

donation {
    bigint id PK
    bigint from_user_id FK
    bigint to_artist_id FK
    decimal amount
    text message
    timestamp donated_at
}

subscription {
    bigint id PK
    bigint subscriber_id FK
    bigint plan_id FK
    bool is_active
    timestamp current_period_start
    timestamp current_period_end
    timestamp canceled_at
    timestamp subscribed_at
    timestamp updated_at
}

membership_plan {
    bigint id PK
    bigint artist_id FK
    varchar name
    text benefits
    bigint image FK
    decimal price_amount
    int max_slots
    bool is_active
    timestamp created_at
    timestamp updated_at
}

commission_offering {
    bigint id PK
    bigint artist_id FK
    varchar title
    text description
    decimal base_price
    int max_slots
    bool is_active
    timestamp created_at
    timestamp updated_at
}

commission_request {
    bigint id PK
    bigint bidder_id FK
    bigint offering_id FK
    text brief
    enum status
    timestamp created_at
    timestamp updated_at
}

commission_submissions {
    bigint request_id PK,FK
    bigint media_id PK,FK
}

%% ---------------------------------------------------------
%% CONTENT & SOCIAL (Orange)
%% ---------------------------------------------------------
post {
    bigint id PK
    bigint user_post_id FK
    enum type
    varchar title
    text content
    bool is_work
    bool is_deleted
    bool is_local
    bigint post_replied_to FK
    bigint post_repost_of FK
    timestamp created_at
    timestamp updated_at
}

post_uploads {
    bigint post_id PK,FK
    bigint media_id PK,FK
    bool is_work_media
}

post_favorites {
    bigint user_id PK,FK
    bigint post_id PK,FK
    timestamp favorited_at
}

like {
    bigint id PK
    bigint user_id FK
    bigint target_id FK
    enum target_type
    timestamp liked_at
}

hashtag {
    bigint id PK
    varchar name
}

post_hashtag {
    bigint post_id PK,FK
    bigint tag_id PK,FK
}

report {
    bigint id PK
    bigint peer_id FK
    bigint reporter_id FK
    bigint category_id FK
    varchar details
    bool is_resolved
    timestamp reported_at
}

report_category {
    bigint id PK
    varchar name
}

moderation_action {
    bigint id PK
    bigint report_id FK
    bigint moderator_id FK
    enum action
    text reason
    timestamp created_at
}

%% ---------------------------------------------------------
%% MEDIA & METADATA (Yellow/White)
%% ---------------------------------------------------------
media {
    bigint id PK
    varchar filename
    varchar mime_type
    varchar path
    int file_size
    timestamp uploaded_at
}

image_metadata {
    bigint id PK
    bigint upload_id FK
    int file_size
    varchar width
    varchar height
    bigint collection_id FK
}

music_metadata {
    bigint id PK
    bigint upload_id FK
    varchar title
    int bitrate_kbps
    int duration_sec
    bigint genre_id FK
    bigint collection_album_id FK
}

text_metadata {
    bigint id PK
    bigint upload_id FK
    varchar title
    varchar sort_title
    varchar subtitle
    text description
    char language
    int word_count
    bigint genre_id FK
    bigint collection_series_id FK
}

genre {
    bigint id PK
    varchar name
    enum type
}

collections {
    bigint id PK
    varchar title
    bigint image FK
    text description
    int item_count
    timestamp created_at
    timestamp updated_at
}

%% ---------------------------------------------------------
%% MESSAGING (Yellow/Pink)
%% ---------------------------------------------------------
conversation {
    bigint id PK
    varchar title
    varchar description
    bigint icon FK
    timestamp created_at
    timestamp updated_at
}

user_conversation {
    bigint user_id PK,FK
    bigint conversation_id PK,FK
}

message {
    bigint id PK
    bigint conversation_id FK
    bigint sender_id FK
    enum content
    timestamp created_at
    timestamp updated_at
}

message_media {
    bigint message_id PK,FK
    bigint media_id PK,FK
}

%% ---------------------------------------------------------
%% NOTIFICATIONS (Purple)
%% ---------------------------------------------------------
notification {
    bigint id PK
    bigint user_id FK
    bigint activity_id FK
    varchar type
    enum status
    timestamp created_at
}

