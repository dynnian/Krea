media ||--|| image_metadata : "extends"
media ||--|| music_metadata : "extends"
media ||--|| text_metadata : "extends"
genre ||--o{ music_metadata : "defines"
genre ||--o{ text_metadata : "defines"
collections ||--o{ image_metadata : "contains"
collections ||--o{ music_metadata : "contains"
collections ||--o{ text_metadata : "contains"

