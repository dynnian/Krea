COMPOSE_PROJECT_NAME=krea

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=krea
POSTGRES_PORT=5432

# Object storage (MinIO)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=minio:9000
MINIO_BASE_URL=http://localhost:9000
MINIO_USE_SSL=false
MINIO_BUCKET=uploads

# API
ASPNETCORE_ENVIRONMENT=Production
API_PORT=5101
ENFORCE_HTTPS_REDIRECTION=false
JWT_ISSUER=KreaAPI
JWT_AUDIENCE=KreaClient
JWT_KEY=replace-with-a-random-secret-at-least-32-characters-long
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
USE_FAKE_EMAIL=true
SEEDING_ENABLED=false
ADMIN_EMAIL=admin@krea.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!
ADMIN_DISPLAY_NAME=Administrator
INSTANCE_PLATFORM_NAME=Krea
INSTANCE_DESCRIPTION=A federated platform for artists and creators
INSTANCE_ADMIN_EMAIL=admin@krea.local

# SMTP (required when USE_FAKE_EMAIL=false)
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=user@example.com
EMAIL_SMTP_PASSWORD=change-me
EMAIL_FROM_ADDRESS=noreply@example.com

# Frontend
WEB_PORT=3000
VITE_API_BASE_URL=http://localhost:5101/api
VITE_API_URL=http://localhost:5101
VITE_HUB_BASE_URL=http://localhost:5101/hubs/directmessage
