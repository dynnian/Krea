COMPOSE_PROJECT_NAME=krea

# --- Secrets (REQUIRED) ---
POSTGRES_PASSWORD=postgres
MINIO_ROOT_PASSWORD=minioadmin
JWT_KEY=replace-with-a-random-secret-at-least-32-characters-long
ADMIN_PASSWORD=ChangeMe123!

# --- Service Configuration ---
WEB_PORT=3000
PUBLIC_URL=http://localhost:3000
SEEDING_ENABLED=true
ASPNETCORE_ENVIRONMENT=Production

# --- Optional SMTP (Required when USE_FAKE_EMAIL=false) ---
# EMAIL_SMTP_HOST=smtp.example.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=user@example.com
# EMAIL_SMTP_PASSWORD=change-me
# EMAIL_FROM_ADDRESS=noreply@example.com

# --- Instance Customization (Optional) ---
# INSTANCE_PLATFORM_NAME=Krea
# INSTANCE_DESCRIPTION=A federated platform for artists and creators
# MINIO_BASE_URL=http://localhost:3000
# MINIO_USE_SSL=false
# MINIO_BUCKET=uploads
