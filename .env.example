COMPOSE_PROJECT_NAME=krea

# --- Core Runtime ---
ASPNETCORE_ENVIRONMENT=Production
WEB_PORT=3000
PUBLIC_URL=http://localhost:3000

# --- Database ---
DB_HOST=postgres
DB_PORT=5432
DB_NAME=krea
DB_USER=postgres
DB_PASSWORD=postgres

# --- MinIO ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=uploads
MINIO_USE_SSL=false
# Optional: Set this to an external URL (e.g., https://s3.amazonaws.com) if using a third-party S3 provider.
# If unset, the backend will proxy upload requests and use PUBLIC_URL for links.
# MINIO_BASE_URL=http://localhost:3000

# --- API Security ---
ENFORCE_HTTPS_REDIRECTION=false

# --- Optional Setup ---
USE_FAKE_EMAIL=true
# TODO: Admin account must always be created, so this environment variable shouldn't exist. Instead, we should have a default password for development and require it to be changed in production.
SEEDING_ENABLED=false
# ADMIN_PASSWORD=ChangeMe123!

# Stripe
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# SMTP (Required when USE_FAKE_EMAIL=false) ---
# EMAIL_SMTP_HOST=smtp.example.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=user@example.com
# EMAIL_SMTP_PASSWORD=change-me
# EMAIL_FROM_ADDRESS=noreply@example.com
# EMAIL_USE_SSL=true

# --- Instance Customization (Optional) ---
# INSTANCE_PLATFORM_NAME=Krea
# INSTANCE_DESCRIPTION=A federated platform for artists and creators
# INSTANCE_ADMIN_EMAIL=admin@krea.local
